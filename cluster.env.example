# ==============================================================================
# Enterprise SRE Kubernetes HA Cluster Environment Variables
# ==============================================================================
# 이 파일을 복사하여 cluster.env 를 생성하고 환경에 맞게 값을 입력하세요.
# 예시: cp cluster.env.example cluster.env
# 적용: source setup-env.sh 또는 ./setup-env.sh --register
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Control Plane VIP & Node IP Topology
# ------------------------------------------------------------------------------
# kube-vip를 통해 선출되는 단일 L2 ARP 가상 엔드포인트 IP
export CONTROL_PLANE_VIP="10.40.101.180"

# 컨트롤 플레인 고정 IP
export CP1_IP="10.40.101.181"
export CP2_IP="10.40.101.182"
export CP3_IP="10.40.101.183"

# 워커 노드 고정 IP
export WORKER1_IP="10.40.101.184"
export WORKER2_IP="10.40.101.185"
export WORKER3_IP="10.40.101.186"

# ------------------------------------------------------------------------------
# 2. Host & Network Interfaces
# ------------------------------------------------------------------------------
# 게이트웨이 및 DNS 서버 주소
export GATEWAY="10.40.101.1"
export DNS="8.8.8.8"

# 노드의 네트워크 인터페이스 (예: ens33, eth0, ens192)
export NET_INTERFACE="ens33"

# 내부 VIP 도메인 및 클러스터 식별자
export VIP_DOMAIN="k8s-vip.infra.internal"
export CLUSTER_NAME="core-cluster"
export K8S_VERSION="v1.28.15"

# ------------------------------------------------------------------------------
# 3. Pod & Service CIDR
# ------------------------------------------------------------------------------
# Cilium eBPF 네이티브 라우팅 Pod 서브넷
export POD_SUBNET="10.244.0.0/16"

# 클러스터 내부 서비스(ClusterIP) 서브넷
export SERVICE_SUBNET="10.96.0.0/12"

# ------------------------------------------------------------------------------
# 4. Observability & Security Credentials
# ------------------------------------------------------------------------------
# Grafana 관리자 비밀번호
export GRAFANA_ADMIN_PASSWORD="<REPLACE_WITH_STRONG_PASSWORD>"
